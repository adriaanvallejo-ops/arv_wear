{%- comment -%}
  ARV Wear FAQ. Answers are factual and based on confirmed store data
  (material, care, offer, policies). Texts come from the locale files.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="arv-faq color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="arv-section-heading">
      <h2 class="h2">{{ 'arv.faq.heading' | t }}</h2>
    </div>
    <div class="arv-accordion">
      {%- for i in (1..8) -%}
        {%- liquid
          assign q_key = 'arv.faq.q' | append: i
          assign a_key = 'arv.faq.a' | append: i
          if i == 6 and settings.arv_free_shipping
            assign a_key = 'arv.faq.a6_free'
          endif
        -%}
        <details class="arv-accordion__item"{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="arv-accordion__summary">
            <span>{{ q_key | t }}</span>
            {% render 'icon-caret' %}
          </summary>
          <div class="arv-accordion__content rte">
            <p>{{ a_key | t }}</p>
            {%- if i == 8 and shop.refund_policy != blank -%}
              <p><a href="{{ shop.refund_policy.url }}">{{ 'arv.details.returns_policy_link' | t }}</a></p>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
    {%- if shop.email != blank -%}
      <p class="arv-faq__contact">
        {{ 'arv.faq.contact' | t: email: shop.email }}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ARV FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Questions and answers are translated automatically (English / Spanish). Edit them in Edit default theme content > arv > faq."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "ARV FAQ"
    }
  ]
}
{% endschema %}
