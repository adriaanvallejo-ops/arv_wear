{%- comment -%}
  ARV Wear benefits (brand copy). Only reasonable, non-medical claims about a
  compression garment. Texts come from the locale files (English / Spanish).
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="arv-benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="arv-section-heading">
      <h2 class="h2">{{ 'arv.benefits.heading' | t }}</h2>
      <p>{{ 'arv.benefits.subheading' | t }}</p>
    </div>
    <div class="arv-benefits__layout{% if section.settings.image != blank %} arv-benefits__layout--image{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="arv-benefits__media">
          {%- liquid
            assign image_alt = section.settings.image.alt
            if image_alt == blank
              assign image_alt = 'arv.hero.image_alt' | t
            endif
          -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 45vw, 100vw',
              widths: '375, 550, 750, 1000',
              alt: image_alt
          }}
        </div>
      {%- endif -%}
      <ul class="arv-benefits__grid" role="list">
        <li class="arv-benefit">
          <span class="arv-benefit__icon">{% render 'arv-icon', icon: 'compress' %}</span>
          <h3 class="arv-benefit__title">{{ 'arv.benefits.b1_title' | t }}</h3>
          <p>{{ 'arv.benefits.b1_text' | t }}</p>
        </li>
        <li class="arv-benefit">
          <span class="arv-benefit__icon">{% render 'arv-icon', icon: 'layers' %}</span>
          <h3 class="arv-benefit__title">{{ 'arv.benefits.b2_title' | t }}</h3>
          <p>{{ 'arv.benefits.b2_text' | t }}</p>
        </li>
        <li class="arv-benefit">
          <span class="arv-benefit__icon">{% render 'arv-icon', icon: 'stretch' %}</span>
          <h3 class="arv-benefit__title">{{ 'arv.benefits.b3_title' | t }}</h3>
          <p>{{ 'arv.benefits.b3_text' | t }}</p>
        </li>
        <li class="arv-benefit">
          <span class="arv-benefit__icon">{% render 'arv-icon', icon: 'fabric' %}</span>
          <h3 class="arv-benefit__title">{{ 'arv.benefits.b4_title' | t }}</h3>
          <p>{{ 'arv.benefits.b4_text' | t }}</p>
        </li>
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ARV benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Texts are translated automatically (English / Spanish). Edit them in Edit default theme content > arv > benefits."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)",
      "info": "Use a real product photo."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "ARV benefits"
    }
  ]
}
{% endschema %}
