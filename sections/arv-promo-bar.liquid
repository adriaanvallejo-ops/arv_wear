{%- comment -%}
  ARV Wear promotion bar.
  Communicates the real bundle offer (Buy 2 Get 1 / Buy 3 Get 2) and, when enabled
  in Theme settings > ARV Wear, free standard shipping. Texts come from the locale
  files, so the US storefront shows English and Spain shows Spanish.
{%- endcomment -%}
{%- capture offer_prefix -%}{% render 'arv-offer-text', part: 'prefix' %}{%- endcapture -%}
{%- capture offer_ends -%}{% render 'arv-offer-text', part: 'ends' %}{%- endcapture -%}
{%- liquid
  assign link = section.settings.link
  if link == blank
    assign link = routes.all_products_collection_url
  endif
-%}
<div class="arv-promo-bar color-{{ section.settings.color_scheme }} gradient" role="region" aria-label="{{ offer_prefix | strip }}">
  <a class="arv-promo-bar__inner page-width" href="{{ link }}">
    <span class="arv-promo-bar__prefix">{{ offer_prefix }}</span>
    <span class="arv-promo-bar__offer">{{ 'arv.promo.offer' | t }}</span>
    {%- if offer_ends != blank -%}
      <span class="arv-promo-bar__extra">{{ offer_ends }}</span>
    {%- endif -%}
    {%- if settings.arv_free_shipping and section.settings.show_shipping -%}
      <span class="arv-promo-bar__extra arv-promo-bar__shipping">{{ 'arv.promo.free_shipping' | t }}</span>
    {%- endif -%}
  </a>
</div>

{% schema %}
{
  "name": "ARV promotion bar",
  "class": "arv-promo-bar-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Texts are translated automatically (English / Spanish) from the theme language files. The offer wording is controlled in Theme settings > ARV Wear — Offer & shipping."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show free standard shipping",
      "default": true,
      "info": "Only visible when \"Standard shipping is free\" is enabled in Theme settings."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "accent-1"
    }
  ],
  "presets": [
    {
      "name": "ARV promotion bar"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
