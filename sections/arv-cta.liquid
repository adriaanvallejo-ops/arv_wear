{%- comment -%}
  ARV Wear closing call to action with the real bundle offer.
  Texts come from the locale files (English / Spanish).
{%- endcomment -%}
{%- liquid
  assign link = section.settings.link
  if link == blank and template.name == 'product'
    # On the product page the button scrolls back up to the purchase area.
    assign link = '#MainContent'
  endif
  if link == blank
    assign link = routes.all_products_collection_url
  endif
-%}
{%- capture offer_ends -%}{% render 'arv-offer-text', part: 'ends' %}{%- endcapture -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="arv-cta color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding center">
    <p class="arv-eyebrow">{% render 'arv-offer-text', part: 'prefix' %}</p>
    <h2 class="h1">{{ 'arv.cta.heading' | t }}</h2>
    <p class="arv-cta__offer">{{ 'arv.promo.offer' | t }}</p>
    <p class="arv-cta__text">{{ 'arv.cta.text' | t }}</p>
    <a class="button button--primary" href="{{ link }}">{{ 'arv.cta.button' | t }}</a>
    <p class="arv-cta__nudge">
      {%- if offer_ends != blank -%}{{ offer_ends }}{%- else -%}{{ 'arv.cta.nudge' | t }}{%- endif -%}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "ARV call to action",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Texts are translated automatically (English / Spanish). Edit them in Edit default theme content > arv > cta."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "info": "Leave empty on the product page to scroll back up to the purchase area."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "accent-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "ARV call to action"
    }
  ]
}
{% endschema %}
