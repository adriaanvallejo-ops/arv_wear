{% comment %}
  Bundle / quantity-break selector.

  Rewritten for ARV Wear (one loop instead of four copy-pasted blocks).
  Keeps the DOM contract used by the theme JavaScript (QuantityBreaks,
  VariantSelects, ProductForm):
  - <quantity-breaks id="quantity-breaks-{section.id}">
  - input[name="quantity"][form][data-input="input_N"] + label.quantity-break[data-input]
  - .dynamic-price elements (same count and order on every render)
  - .quantity-break__variants > .quantity-break__selector-item[data-select-index][data-selected-id]
    > select.quantity-break__variant-select
  - script[type="application/json"][data-has-variants]

  Pricing
  - "Free items" mode (option_N_free_quantity > 0): total = item price x (quantity - free items).
    Prices come from the selected variant in the visitor's currency, so they are correct in EUR and USD.
    Labels ("Buy 2, Get 1 Free") are generated from the numbers and translated via locales.
  - Legacy mode (no free items): percentage / fixed amount settings, as before.
  - The strikethrough value is always the regular price (item price x quantity), never compare-at prices.
  The discount itself is applied by the automatic discounts configured in Shopify Admin.

  Accepts:
  - block: {Object}
  - product: {Object}
  - product_form_id: {String}
{% endcomment %}
{%- liquid
  assign item_count = 0
  assign best_each = 0
  assign best_index = 0
  assign price = product.selected_or_first_available_variant.price
  assign has_variants = false

  for i in (1..4)
    assign qty_key = 'option_' | append: i | append: '_quantity'
    assign free_key = 'option_' | append: i | append: '_free_quantity'
    assign pct_key = 'option_' | append: i | append: '_percentage_off_text'
    assign fixed_key = 'option_' | append: i | append: '_fixed_amount_off'
    assign qty = block.settings[qty_key] | plus: 0
    if qty > 0
      assign item_count = item_count | plus: 1
      assign free = block.settings[free_key] | plus: 0
      if free > 0 and free < qty
        assign paid = qty | minus: free
        assign total = price | times: paid
      else
        assign pct = block.settings[pct_key] | plus: 0
        assign pct_left = 100 | minus: pct | divided_by: 100.0
        assign fixed = block.settings[fixed_key] | times: 100
        assign total = price | times: qty | times: pct_left | minus: fixed | round
      endif
      assign regular = price | times: qty
      if qty > 1 and total < regular
        assign each = total | times: 1.0 | divided_by: qty
        if best_each == 0 or each < best_each
          assign best_each = each
          assign best_index = i
        endif
      endif
    endif
  endfor

-%}
{%- capture offer_ends -%}{% render 'arv-offer-text', part: 'ends' %}{%- endcapture -%}
{%- if block.settings.headline != blank -%}
  {%- assign headline = block.settings.headline -%}
{%- else -%}
  {%- capture headline -%}{% render 'arv-offer-text', part: 'heading' %}{%- endcapture -%}
{%- endif -%}
<quantity-breaks
  class="quantity-breaks quantity-breaks--{{ block.settings.style }} arv-offers accent-color-{{ block.settings.color_scheme }}{% if block.settings.space_images %} quantity-breaks--space-images{% endif %}"
  id="quantity-breaks-{{ section.id }}"
  data-section="{{ section.id }}"
  data-items="{{ item_count }}"
  style="{% if block.settings.hide_pickers_overlay %}--pickers-overlay-opacity:0;--pickers-hover-overlay-opacity:0;{% endif %}--items-count:{{ item_count }};--image-width:{{ block.settings.image_width }}%;--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
  {{ block.shopify_attributes }}
>
  <div class="arv-offers__header">
    <h3 class="arv-offers__title">{% render 'arv-icon', icon: 'tag' %}<span>{{ headline }}</span></h3>
    {%- if offer_ends != blank -%}
      <p class="arv-offers__ends">{% render 'arv-icon', icon: 'calendar' %}<span>{{ offer_ends }}</span></p>
    {%- endif -%}
  </div>

  <div class="quantity-breaks-container">
    {%- for i in (1..4) -%}
      {%- liquid
        assign qty_key = 'option_' | append: i | append: '_quantity'
        assign qty = block.settings[qty_key] | plus: 0

        assign free_key = 'option_' | append: i | append: '_free_quantity'
        assign pct_key = 'option_' | append: i | append: '_percentage_off_text'
        assign fixed_key = 'option_' | append: i | append: '_fixed_amount_off'
        assign label_key = 'option_' | append: i | append: '_label'
        assign badge_key = 'option_' | append: i | append: '_badge'

        assign free = block.settings[free_key] | plus: 0
        assign offer_mode = false
        if free > 0 and free < qty
          assign offer_mode = true
          assign paid = qty | minus: free
          assign total = price | times: paid
        else
          assign pct = block.settings[pct_key] | plus: 0
          assign pct_left = 100 | minus: pct | divided_by: 100.0
          assign fixed = block.settings[fixed_key] | times: 100
          assign total = price | times: qty | times: pct_left | minus: fixed | round
        endif
        assign regular = price | times: qty
        assign saved = regular | minus: total
        assign each = total
        if qty > 1
          assign each = total | times: 1.0 | divided_by: qty | round
        endif
        assign each_money = each | money
        assign saved_money = saved | money

        assign input_id = 'quantity-' | append: section.id | append: '-' | append: i
        assign preselect_key = 'option_' | append: i
      -%}
      {%- if qty > 0 -%}
      <input
        id="{{ input_id }}"
        aria-label="{% if offer_mode %}{{ 'arv.bundle.buy_get' | t: buy: paid, get: free }}{% else %}{{ 'arv.bundle.items' | t: count: qty }}{% endif %}"
        type="radio"
        name="quantity"
        value="{{ qty }}"
        form="{{ product_form_id }}"
        {% if block.settings.preselected == preselect_key %}checked{% endif %}
        data-input="input_{{ i }}"
      >
      <label
        for="{{ input_id }}"
        class="quantity-break arv-offer{% if best_index == i %} arv-offer--best{% endif %}"
        data-quantity="{{ qty }}"
        data-input="input_{{ i }}"
      >
        <span class="arv-offer__badges dynamic-price">
          {%- if block.settings[badge_key] != blank and offer_mode == false -%}
            <span class="arv-badge">{{ block.settings[badge_key] | escape }}</span>
          {%- endif -%}
          {%- if best_index == i -%}
            <span class="arv-badge arv-badge--accent">{{ 'arv.bundle.best_value' | t }}</span>
          {%- endif -%}
        </span>
        <span class="arv-offer__row">
          <span class="arv-offer__main">
            <span class="arv-offer__title">
              {%- if offer_mode -%}
                {{ 'arv.bundle.buy_get' | t: buy: paid, get: free }}
              {%- elsif qty == 1 -%}
                {{ 'arv.bundle.single' | t }}
              {%- elsif block.settings[label_key] != blank -%}
                {{ block.settings[label_key] | replace: '[quantity]', qty | escape }}
              {%- else -%}
                {{ 'arv.bundle.items' | t: count: qty }}
              {%- endif -%}
            </span>
            <span class="arv-offer__meta dynamic-price">
              {{- 'arv.bundle.items' | t: count: qty -}}
              {%- if qty > 1 %} · {{ 'arv.bundle.each' | t: price: each_money }}{% endif -%}
            </span>
          </span>
          <span class="arv-offer__price dynamic-price">
            <span class="arv-offer__total">{{ total | money }}</span>
            {%- if saved > 0 -%}
              <s class="arv-offer__regular">{{ regular | money }}</s>
              <span class="arv-offer__save">{{ 'arv.bundle.save' | t: amount: saved_money }}</span>
            {%- endif -%}
          </span>
        </span>

        {%- if product.has_only_default_variant == false and block.settings.enable_variant_selectors -%}
          {%- if qty != 1 or block.settings.enable_variant_selectors_on_quantity_of_1 -%}
            {%- assign has_variants = true -%}
            <div class="quantity-break__variants">
              <details class="arv-mix">
                <summary class="arv-mix__summary">{{ 'arv.product.mix_toggle' | t }}</summary>
                <p class="arv-mix__hint">{{ 'arv.product.mix_hint' | t }}</p>
                {%- for selector_item in (1..qty) -%}
                  <div
                    class="quantity-break__selector-item"
                    data-select-index="{{ forloop.index0 }}"
                    data-selected-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    <span class="quantity-break__selector-item__number">{{ 'arv.product.item_number' | t: number: selector_item }}</span>
                    {%- for option in product.options_with_values -%}
                      <div class="select select--small no-background color-{{ settings.pickers_color_scheme }} accent-color-{{ settings.pickers_overlay_color }} accent-2-color-{{ settings.pickers_text_color }}">
                        <select
                          class="quantity-break__variant-select select__select variant-dropdown"
                          name="options[{{ option.name | escape }}]"
                          aria-label="{{ 'arv.product.item_number' | t: number: selector_item }} – {{ option.name | escape }}"
                          data-product-id="{{ product.selected_or_first_available_variant.id }}"
                        >
                          {%- for value in option.values -%}
                            {%- liquid
                              assign option_disabled = true
                              for variant in product.variants
                                case option.position
                                  when 1
                                    if variant.option1 == value and variant.available
                                      assign option_disabled = false
                                      break
                                    endif
                                  when 2
                                    if variant.option1 == product.selected_or_first_available_variant.option1 and variant.option2 == value and variant.available
                                      assign option_disabled = false
                                      break
                                    endif
                                  when 3
                                    if variant.option1 == product.selected_or_first_available_variant.option1 and variant.option2 == product.selected_or_first_available_variant.option2 and variant.option3 == value and variant.available
                                      assign option_disabled = false
                                      break
                                    endif
                                endcase
                              endfor
                              assign display_value = value
                              if value == 'XXXL'
                                assign display_value = '3XL'
                              endif
                            -%}
                            <option value="{{ value | escape }}"{% if option.selected_value == value %} selected="selected"{% endif %}>
                              {%- if option_disabled -%}
                                {{- 'products.product.value_unavailable' | t: option_value: display_value -}}
                              {%- else -%}
                                {{- display_value -}}
                              {%- endif -%}
                            </option>
                          {%- endfor -%}
                        </select>
                        {% render 'icon-caret' %}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </details>
            </div>
          {%- endif -%}
        {%- endif -%}
      </label>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <p class="arv-offers__note">{{ 'arv.bundle.auto_applied' | t }}</p>

  <script data-has-variants="{{ has_variants }}" type="application/json">
    {{ product.variants | json }}
  </script>
</quantity-breaks>
