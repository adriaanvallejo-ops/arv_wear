{% comment %}
  Lightweight inline SVG icons for ARV components (no icon font request).
  Accepts: icon {String}
{% endcomment %}
<svg class="arv-icon arv-icon--{{ icon }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon -%}
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
    {%- when 'ruler' -%}
      <path d="M3 17 17 3l4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- when 'return' -%}
      <path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
    {%- when 'lock' -%}
      <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {%- when 'fabric' -%}
      <path d="M8 3 4 6l2 4 2-1v12h8V9l2 1 2-4-4-3a4 4 0 0 1-8 0z"/>
    {%- when 'wash' -%}
      <path d="M3 7h18l-2 13H5z"/><path d="M6 11c1.5 1 3 1 4.5 0s3-1 4.5 0 3 1 3 0"/>
    {%- when 'compress' -%}
      <path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4"/>
    {%- when 'layers' -%}
      <path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>
    {%- when 'stretch' -%}
      <path d="M3 12c3-4 6-4 9 0s6 4 9 0"/><path d="M3 18c3-4 6-4 9 0s6 4 9 0"/>
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
    {%- when 'tag' -%}
      <path d="M3 12V3h9l9 9-9 9z"/><circle cx="7.5" cy="7.5" r="1.3"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
